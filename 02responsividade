@import url("https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,400;9..144,500;9..144,600;9..144,700&family=Work+Sans:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap");

* {
    margin: 0;
    padding: 0;
    border: 0;
    box-sizing: border-box;
}

html {
    scroll-behavior: smooth;
}

body {
    background: #f7f1ea;
    color: #372430;
    font-family: "Work Sans", sans-serif;
    line-height: 1.65;
    padding: 32px clamp(16px, 3vw, 40px);
    min-height: 100vh;
}

a {
    color: inherit;
    text-decoration: none;
}

:focus-visible {
    outline: 2px solid #a4436b;
    outline-offset: 3px;
}

/* ---------- Tela principal (index) ---------- */

.controles {
    width: 100%;
    max-width: 1200px;
    margin: 0 auto 40px;
    display: flex;
    gap: 12px;
    align-items: center;
    flex-wrap: wrap;
    padding-bottom: 24px;
    border-bottom: 1px dashed rgba(227, 214, 202, 0.8);
}

.controles button {
    font-family: "JetBrains Mono", monospace;
    font-size: 12.5px;
    background: #a4436b;
    color: #fffdfa;
    padding: 10px 18px;
    border-radius: 20px;
    cursor: pointer;
    transition: background 0.2s ease, transform 0.15s ease;
}

.controles button:hover {
    background: #7d3252;
    transform: translateY(-2px);
}

.controles input,
.controles select {
    font-family: "Work Sans", sans-serif;
    font-size: 14px;
    padding: 9px 14px;
    border-radius: 20px;
    border: 1px solid #e3d6ca;
    background: #fffdfa;
    color: #372430;
    outline: none;
    transition: border-color 0.2s ease;
}

.controles input:focus,
.controles select:focus {
    border-color: #a4436b;
}

.containerCards {
    width: 100%;
    max-width: 1200px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
    gap: 20px;
}

.card {
    background: #fffdfa;
    border: 1px solid #e3d6ca;
    border-radius: 18px;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    transition: box-shadow 0.25s ease, transform 0.25s ease, border-color 0.25s ease;
}

.card:hover {
    box-shadow: 0 14px 35px -20px rgba(55, 36, 48, 0.3);
    transform: translateY(-3px);
    border-color: #a4436b;
}

.card img {
    width: 100%;
    aspect-ratio: 2 / 3;
    object-fit: cover;
}

.card h3 {
    font-family: "Fraunces", serif;
    font-weight: 600;
    font-size: 17px;
    color: #372430;
    padding: 14px 14px 6px;
}

.card p {
    font-family: "JetBrains Mono", monospace;
    font-size: 11px;
    color: #7d3252;
    padding: 0 14px;
    margin-bottom: 4px;
}

.btn-acoes {
    display: flex;
    gap: 6px;
    padding: 14px;
    margin-top: auto;
    flex-wrap: wrap;
}

.btn-acoes button {
    flex: 1;
    font-family: "JetBrains Mono", monospace;
    font-size: 11px;
    color: #7d3252;
    background: rgba(164, 67, 107, 0.08);
    border: 1px solid rgba(164, 67, 107, 0.25);
    padding: 7px 8px;
    border-radius: 8px;
    cursor: pointer;
    transition: background 0.2s ease, color 0.2s ease;
}

.btn-acoes button:hover {
    background: #a4436b;
    color: #fffdfa;
}

/* ---------- Botões gerais (formulários) ---------- */

button {
    cursor: pointer;
}

.btn-primary {
    font-family: "JetBrains Mono", monospace;
    font-size: 13px;
    background: #a4436b;
    color: #fffdfa;
    padding: 11px 22px;
    border-radius: 20px;
    transition: background 0.2s ease, transform 0.15s ease;
}

.btn-primary:hover {
    background: #7d3252;
    transform: translateY(-2px);
}

.btn-secondary {
    font-family: "JetBrains Mono", monospace;
    font-size: 13px;
    background: transparent;
    color: #6e5a67;
    border: 1px solid #e3d6ca;
    padding: 11px 22px;
    border-radius: 20px;
    transition: border-color 0.2s ease, color 0.2s ease;
}

.btn-secondary:hover {
    border-color: #a4436b;
    color: #a4436b;
}

/* Formulários */

.form-container {
    width: 100%;
    max-width: 700px;
    margin: 0 auto;
    background: #fffdfa;
    border: 1px solid #e3d6ca;
    border-radius: 22px;
    padding: 36px;
}

.form-container h2 {
    font-family: "Fraunces", serif;
    font-weight: 600;
    font-size: 26px;
    color: #372430;
    margin-bottom: 24px;
}

.input-group,
.input-groupd {
    display: flex;
    flex-direction: column;
    margin-bottom: 18px;
}

.input-group label,
.input-groupd label {
    font-family: "JetBrains Mono", monospace;
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: #bd9760;
    margin-bottom: 8px;
}

.input-group input,
.input-group select,
.input-group textarea,
.input-groupd input,
.input-groupd select,
.input-groupd textarea {
    width: 100%;
    font-family: "Work Sans", sans-serif;
    font-size: 14.5px;
    padding: 12px 14px;
    border-radius: 10px;
    border: 1px solid #e3d6ca;
    background: #f7f1ea;
    color: #372430;
    outline: none;
    transition: border-color 0.2s ease;
}

.input-group input:focus,
.input-group select:focus,
.input-group textarea:focus,
.input-groupd input:focus,
.input-groupd select:focus,
.input-groupd textarea:focus {
    border-color: #a4436b;
}

.input-group textarea,
.input-groupd textarea {
    min-height: 120px;
    resize: vertical;
}

.form-actions {
    display: flex;
    gap: 10px;
    margin-top: 22px;
}

/* Mensagens */

#mensagem {
    margin-bottom: 18px;
}

#mensagem:empty {
    display: none;
}

.mensagem-erro,
.mensagem-sucesso {
    font-family: "JetBrains Mono", monospace;
    font-size: 12.5px;
    padding: 12px 14px;
    border-radius: 10px;
    border-left: 3px solid;
}

.mensagem-erro {
    background: rgba(164, 67, 107, 0.08);
    border-color: #a4436b;
    color: #7d3252;
}

.mensagem-sucesso {
    background: rgba(189, 151, 96, 0.12);
    border-color: #bd9760;
    color: #8a6b3a;
}

/* Página de visualização */

.detalhes-item {
    width: 100%;
    max-width: 700px;
    margin: 0 auto;
}

.detalhes-item img {
    width: 100%;
    max-width: 240px;
    border-radius: 14px;
    margin-bottom: 20px;
    border: 3px solid #fffdfa;
    box-shadow: 0 8px 24px -10px rgba(55, 36, 48, 0.25);
}

.detalhes-item h3 {
    font-family: "Fraunces", serif;
    font-weight: 600;
    font-size: 26px;
    color: #372430;
    margin-bottom: 14px;
}

/* Responsividade */

@media (max-width: 900px) {

    .containerCards {
        grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
    }

    .form-container {
        max-width: 100%;
    }

}


/* Celular */

@media (max-width: 700px) {

    body {
        padding: 20px 16px;
    }

    .controles {
        margin-bottom: 25px;
    }

    .controles input,
    .controles select,
    .controles button {
        width: 100%;
    }

    .containerCards {
        grid-template-columns: repeat(2, 1fr);
        gap: 14px;
    }

    .card h3 {
        font-size: 15px;
        padding: 12px 10px 5px;
    }

    .card p {
        font-size: 10px;
        padding: 0 10px;
    }

    .btn-acoes {
        flex-direction: column;
        padding: 10px;
    }

    .btn-acoes button {
        width: 100%;
    }

    .form-container {
        padding: 24px 18px;
        border-radius: 18px;
    }

    .form-container h2 {
        font-size: 22px;
    }

    .form-actions {
        flex-direction: column;
    }

    .form-actions button {
        width: 100%;
    }

    .detalhes-item h3 {
        font-size: 22px;
    }

}


/* Celulares menores */

@media (max-width: 400px) {

    .containerCards {
        grid-template-columns: 1fr;
    }

    .card img {
        aspect-ratio: 2 / 3;
    }

}